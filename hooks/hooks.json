{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${PLUGIN_ROOT:-}\"; if command -v node >/dev/null 2>&1 && [ -n \"$ROOT\" ]; then node \"$ROOT/hooks/chief-of-staff-hook.js\" session; fi",
            "commandWindows": "$root = $env:PLUGIN_ROOT; if ($root -and (Get-Command node -ErrorAction SilentlyContinue)) { node (Join-Path $root 'hooks\\chief-of-staff-hook.js') session }",
            "timeout": 5,
            "statusMessage": "Loading Chief of Staff contract..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${PLUGIN_ROOT:-}\"; if command -v node >/dev/null 2>&1 && [ -n \"$ROOT\" ]; then node \"$ROOT/hooks/chief-of-staff-hook.js\" subagent; fi",
            "commandWindows": "$root = $env:PLUGIN_ROOT; if ($root -and (Get-Command node -ErrorAction SilentlyContinue)) { node (Join-Path $root 'hooks\\chief-of-staff-hook.js') subagent }",
            "timeout": 5,
            "statusMessage": "Loading Chief of Staff contract..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${PLUGIN_ROOT:-}\"; if command -v node >/dev/null 2>&1 && [ -n \"$ROOT\" ]; then node \"$ROOT/hooks/icm-enforcement-hook.js\"; fi",
            "commandWindows": "$root = $env:PLUGIN_ROOT; if ($root -and (Get-Command node -ErrorAction SilentlyContinue)) { node (Join-Path $root 'hooks\\icm-enforcement-hook.js') }",
            "timeout": 5,
            "statusMessage": "Applying ICM response enforcement..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${PLUGIN_ROOT:-}\"; if command -v node >/dev/null 2>&1 && [ -n \"$ROOT\" ]; then node \"$ROOT/hooks/icm-enforcement-hook.js\"; fi",
            "commandWindows": "$root = $env:PLUGIN_ROOT; if ($root -and (Get-Command node -ErrorAction SilentlyContinue)) { node (Join-Path $root 'hooks\\icm-enforcement-hook.js') }",
            "timeout": 5,
            "statusMessage": "Checking ICM prompt-only scope..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${PLUGIN_ROOT:-}\"; if command -v node >/dev/null 2>&1 && [ -n \"$ROOT\" ]; then node \"$ROOT/hooks/icm-enforcement-hook.js\"; fi",
            "commandWindows": "$root = $env:PLUGIN_ROOT; if ($root -and (Get-Command node -ErrorAction SilentlyContinue)) { node (Join-Path $root 'hooks\\icm-enforcement-hook.js') }",
            "timeout": 5,
            "statusMessage": "Validating ICM response contract..."
          }
        ]
      }
    ]
  }
}
